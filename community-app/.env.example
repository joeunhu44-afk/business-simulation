# ==============================
# 필수
# ==============================

# 세션(JWT) 서명용 비밀키. 아무 긴 무작위 문자열이나 사용.
# 생성 예시: openssl rand -hex 32
JWT_SECRET=

# MySQL 접속 문자열 (예: Railway MySQL 플러그인이 자동으로 채워줌)
DATABASE_URL=mysql://user:password@host:3306/dbname

# 배포된 앱의 실제 주소 (뒤에 슬래시 없이). 로컬 개발 시에는 http://localhost:3000
APP_URL=https://mydomain.com

# 이 이메일로 회원가입/로그인하면 자동으로 admin 권한이 부여됨
OWNER_EMAIL=me@example.com

# ==============================
# 소셜 로그인 (사용할 것만 채우면 됨 — 비워두면 해당 버튼 클릭 시 에러 응답)
# ==============================

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
# 승인된 리디렉션 URI에 반드시 추가: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 카카오 개발자 콘솔(developers.kakao.com) > 내 애플리케이션 > 앱 키
# Redirect URI에 반드시 추가: {APP_URL}/api/auth/kakao/callback
# "카카오 로그인 > 보안 > Client Secret"을 활성화했다면 아래도 채울 것 (선택)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Apple Developer > Certificates, Identifiers & Profiles
# APPLE_CLIENT_ID: Services ID (예: com.mydomain.app.web)
# APPLE_TEAM_ID: 계정 팀 ID
# APPLE_KEY_ID: "Sign in with Apple" 용으로 만든 키의 Key ID
# APPLE_PRIVATE_KEY: 다운로드한 .p8 파일 내용 전체 (줄바꿈은 \n 으로 이어써도 됨)
# Return URL에 반드시 추가: {APP_URL}/api/auth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# ==============================
# 파일/이미지 스토리지 (Cloudflare R2 권장 — S3 호환이면 무엇이든 가능)
# ==============================

# R2 예시: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 업로드된 파일을 실제로 열람할 때 쓸 공개 URL (R2 Public Development URL 또는 연결한 커스텀 도메인)
S3_PUBLIC_URL=
